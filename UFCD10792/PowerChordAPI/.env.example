# Copia este ficheiro para .env e ajusta os valores se necessário.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# SQL Server usado pelo docker-compose
SA_PASSWORD=Your_password123
ConnectionStrings__DefaultConnection=Server=sqlserver,1433;Database=PowerChordDB;User Id=sa;Password=Your_password123;TrustServerCertificate=True;

# JWT
Jwt__Key=production_change_this_super_secret_key_123456789_very_secure
Jwt__Issuer=PowerChordAPI
Jwt__Audience=PowerChordClient

# Serviços externos
Redis__ConnectionString=redis:6379,abortConnect=false
ExternalServices__PaymentsBaseUrl=http://mountebank:3000
